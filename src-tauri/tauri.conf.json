{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotlist",
  "version": "1.0.2",
  "identifier": "app.shotlist.mobile",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shotlist",
        "width": 1360,
        "height": 900,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Storyboards and shot lists",
    "longDescription": "Shotlist: script to shot list to hand-drawn storyboard frames, synced through your own server.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://shotlist.duckdns.org/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MDBGNTE0NzkxQUQxMEQKUldRTjBScDVGUFVBTmx3ZG5HNzY4MU53N2p1N1RwdUVSZ2gyTDZHTlFDNmxZV3hvYjBwUmhTQ3MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
