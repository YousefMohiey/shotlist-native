{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotlist",
  "version": "1.0.0",
  "identifier": "app.shotlist.mobile",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Shotlist",
        "width": 1360,
        "height": 900,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Storyboards and shot lists",
    "longDescription": "Shotlist: script to shot list to hand-drawn storyboard frames, synced through your own server."
  }
}
